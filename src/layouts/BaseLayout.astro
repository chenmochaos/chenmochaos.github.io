---
import { ClientRouter } from 'astro:transitions';
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
  /**
   * 放宽内容列宽度，给右侧大纲目录腾地方。默认 false —— 首页等其它页面
   * 保持 800px 单列不变，只有文章详情页需要这条更宽的轨道。
   * 只在 xl 及以上放宽：窄屏不显示目录，放宽只会把正文拉成过长的行宽。
   */
  wide?: boolean;
}

const { title, description = 'Personal blog & digital garden', wide = false } = Astro.props;
const canonicalURL = new URL(Astro.url.pathname, Astro.site);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="canonical" href={canonicalURL} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;600;700&display=swap"
      rel="stylesheet"
    />
    <title>{title}</title>
    <ClientRouter />
  </head>
  <body class="min-h-screen">
    <main
      class:list={['mx-auto px-6 max-w-content', wide && 'xl:max-w-wide']}
      transition:animate="fade"
    >
      <slot />
    </main>
    <script>
      const observer = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) {
              entry.target.classList.add('visible');
            }
          });
        },
        { threshold: 0.1 }
      );
      document.querySelectorAll('.reveal').forEach((el) => observer.observe(el));
      document.addEventListener('astro:after-swap', () => {
        document.querySelectorAll('.reveal').forEach((el) => observer.observe(el));
      });

      // 浏览量统计。打包出来的 module 脚本在 ClientRouter 导航时不会重新执行，所以
      // 驱动放在这里（只跑一次）而不是 ViewCounter 自己的 <script> 里；只在当前页确实
      // 有占位元素时才动态 import，首页不下载这段代码。失败只 warn，页面不受影响。
      document.addEventListener('astro:page-load', () => {
        if (!document.querySelector('[data-view-counter]')) return;
        import('../lib/views-view.js')
          .then(({ renderCounters }) => renderCounters())
          .catch((err) => console.warn('[views] 浏览量获取失败：', err));
      });
    </script>
  </body>
</html>
