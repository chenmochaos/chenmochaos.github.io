---
import BaseLayout from './BaseLayout.astro';
import TableOfContents from '../components/TableOfContents.astro';

interface Props {
  title: string;
  description?: string;
  pubDate: Date;
  updatedAt?: Date;
  tags?: string[];
  headings: { depth: number; slug: string; text: string }[];
}

const { title, description, pubDate, updatedAt, tags, headings } = Astro.props;

// 同一天不显示「Updated」：刚发出来就挂上一行更新日期是噪音。
const sameDay = (a: Date, b: Date) =>
  a.getFullYear() === b.getFullYear() &&
  a.getMonth() === b.getMonth() &&
  a.getDate() === b.getDate();

const updatedAtLabel =
  updatedAt && !sameDay(updatedAt, pubDate)
    ? updatedAt.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' })
    : null;
---

<BaseLayout wide title={`${title} — Minus`} description={description}>
  {/* 三列：两侧 1fr 均分，中间写死 47rem(752px) —— 即 800px 的 --max-width-content 减去 main
      的 px-6 两侧留白，也就是加目录之前正文实际占的宽度，所以正文逐像素没变、仍然居中，
      右侧空出来的那一列放大纲目录。xl 以下不进入 grid，退回原来的单列布局。 */}
  <div class="xl:grid xl:grid-cols-[minmax(0,1fr)_minmax(0,47rem)_minmax(0,1fr)]">
    <article class="py-20 animate-fade-in-up xl:col-start-2">
      <header class="mb-12">
        <a
          href="/"
          class="text-text-dim hover:text-accent transition-colors duration-200 text-sm inline-flex items-center gap-1 mb-8"
        >
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M19 12H5" />
            <path d="m12 19-7-7 7-7" />
          </svg>
          Back
        </a>
        <h1 class="text-4xl md:text-5xl font-bold tracking-tight">{title}</h1>
        <div class="flex items-center gap-4 mt-4">
          <time datetime={pubDate.toISOString()} class="text-text-dim text-sm">
            {pubDate.toLocaleDateString('en-US', {
              year: 'numeric',
              month: 'long',
              day: 'numeric',
            })}
          </time>
          {updatedAtLabel && (
            <time datetime={updatedAt?.toISOString()} class="text-text-dim text-sm">
              Updated {updatedAtLabel}
            </time>
          )}
          {tags && tags.length > 0 && (
            <div class="flex gap-2">
              {tags.map((tag) => (
                <span class="text-xs text-text-dim bg-bg-card border border-border px-2 py-0.5 rounded-full">
                  {tag}
                </span>
              ))}
            </div>
          )}
        </div>
      </header>

      <div class="prose-custom">
        <slot />
      </div>

      <footer class="mt-16 pt-8 border-t border-border">
        <a
          href="/"
          class="text-text-dim hover:text-accent transition-colors duration-200 text-sm inline-flex items-center gap-1"
        >
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M19 12H5" />
            <path d="m12 19-7-7 7-7" />
          </svg>
          Back to home
        </a>
      </footer>
    </article>

    <TableOfContents headings={headings} />
  </div>
</BaseLayout>

<style is:global>
  .prose-custom {
    line-height: 1.8;
  }

  /* 目录锚点跳转后标题不要贴到视口顶部 —— 配合 global.css 里的 scroll-behavior: smooth。 */
  .prose-custom h2,
  .prose-custom h3,
  .prose-custom h4 {
    scroll-margin-top: 2rem;
  }

  .prose-custom h2 {
    font-size: 1.5rem;
    font-weight: 600;
    margin-top: 2.5rem;
    margin-bottom: 1rem;
    color: var(--color-text);
  }

  .prose-custom h3 {
    font-size: 1.25rem;
    font-weight: 600;
    margin-top: 2rem;
    margin-bottom: 0.75rem;
    color: var(--color-text);
  }

  .prose-custom p {
    color: var(--color-text-muted);
    margin-bottom: 1.25rem;
  }

  .prose-custom a {
    color: var(--color-accent);
    text-decoration: underline;
    text-underline-offset: 3px;
    transition: opacity 0.2s ease;
  }

  .prose-custom a:hover {
    opacity: 0.7;
  }

  .prose-custom strong {
    color: var(--color-text);
    font-weight: 600;
  }

  .prose-custom ul,
  .prose-custom ol {
    color: var(--color-text-muted);
    padding-left: 1.5rem;
    margin-bottom: 1.25rem;
  }

  .prose-custom li {
    margin-bottom: 0.5rem;
  }

  .prose-custom ul li {
    list-style-type: disc;
  }

  .prose-custom ol li {
    list-style-type: decimal;
  }

  .prose-custom blockquote {
    border-left: 2px solid var(--color-border);
    padding-left: 1rem;
    margin: 1.5rem 0;
    color: var(--color-text-dim);
    font-style: italic;
  }

  .prose-custom pre {
    background-color: var(--color-bg-card);
    border: 1px solid var(--color-border);
    border-radius: 0.5rem;
    padding: 1rem;
    overflow-x: auto;
    margin: 1.5rem 0;
    font-size: 0.875rem;
    line-height: 1.6;
  }

  .prose-custom :not(pre) > code {
    background-color: var(--color-bg-card);
    border: 1px solid var(--color-border);
    border-radius: 0.25rem;
    padding: 0.15rem 0.4rem;
    font-size: 0.875em;
    color: var(--color-accent);
  }

  .prose-custom hr {
    border: none;
    border-top: 1px solid var(--color-border);
    margin: 2rem 0;
  }

  .prose-custom img {
    border-radius: 0.5rem;
    margin: 1.5rem 0;
  }

  .prose-custom h4 {
    font-size: 1.125rem;
    font-weight: 600;
    margin-top: 1.75rem;
    margin-bottom: 0.5rem;
    color: var(--color-text);
  }

  .prose-custom h5 {
    font-size: 1rem;
    font-weight: 600;
    margin-top: 1.5rem;
    margin-bottom: 0.5rem;
    color: var(--color-text);
  }

  .prose-custom h6 {
    font-size: 0.9rem;
    font-weight: 600;
    margin-top: 1.5rem;
    margin-bottom: 0.5rem;
    color: var(--color-text);
  }

  .prose-custom ul ul,
  .prose-custom ul ol,
  .prose-custom ol ul,
  .prose-custom ol ol {
    margin-top: 0.25rem;
    margin-bottom: 0;
  }

  .prose-custom ul ul li {
    list-style-type: circle;
  }

  .prose-custom ul ul ul li {
    list-style-type: square;
  }

  .prose-custom li.task-list-item {
    list-style: none;
    margin-left: -1.25rem;
  }

  .prose-custom input[type='checkbox'] {
    margin-right: 0.5rem;
    vertical-align: middle;
    accent-color: var(--color-text);
  }

  .prose-custom table {
    display: block;
    width: 100%;
    overflow-x: auto;
    border-collapse: collapse;
    font-size: 0.9rem;
    margin: 1.5rem 0;
  }

  .prose-custom th,
  .prose-custom td {
    border: 1px solid var(--color-border);
    padding: 0.5rem 0.75rem;
    text-align: left;
  }

  .prose-custom th {
    background-color: var(--color-bg-card);
    color: var(--color-text);
    font-weight: 600;
  }

  .prose-custom td {
    color: var(--color-text-muted);
  }
</style>
