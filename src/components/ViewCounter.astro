---
/**
 * 文章浏览量占位 + 唯一一段客户端脚本。
 *
 * 数字是客户端拿的（静态站没有服务端可写），但占位的宽高始终预留，
 * 数据到达只是把 visibility 打开，页头不会因为数字出现而换行或抖动。
 */
interface Props {
  slug: string;
}

const { slug } = Astro.props;
---

<span
  class="view-counter inline-flex items-center gap-1.5 text-text-dim text-sm"
  data-view-counter
  data-slug={slug}
>
  <svg
    width="14"
    height="14"
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="2"
    stroke-linecap="round"
    stroke-linejoin="round"
    aria-hidden="true"
  >
    <path d="M2 12s3-7 10-7 10 7 10 7-3 7-10 7-10-7-10-7Z"></path>
    <circle cx="12" cy="12" r="3"></circle>
  </svg>
  <span data-view-count class="tabular-nums"></span>
  <span class="sr-only">views</span>
</span>

<style>
  .view-counter {
    min-width: 4.5rem;
    visibility: hidden;
  }

  .view-counter[data-ready] {
    visibility: visible;
  }
</style>
